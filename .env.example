# Email Configuration
EMAIL=
EMAIL_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Gmail API (alternative to SMTP - set USE_GMAIL_API=true and provide credentials file path)
USE_GMAIL_API=false
GMAIL_CREDENTIALS_FILE=credentials.json

# Schedule Configuration
CHECK_INTERVAL=60  # minutes
CRON_SCHEDULE=*/60 * * * *

# Database
DATABASE_PATH=data/opportunities.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/dedan_remote.log

# Telegram (optional)
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord (optional)
ENABLE_DISCORD=false
DISCORD_WEBHOOK_URL=

# Scraper Configuration
REQUEST_TIMEOUT=30
MAX_RETRIES=3
CONCURRENT_SCRAPERS=5
RATE_LIMIT_DELAY=1.0
CACHE_TTL=300

# Ranking Weights (must sum to 1.0)
RANKING_WEIGHT_REMOTE=0.20
RANKING_WEIGHT_WORLDWIDE=0.15
RANKING_WEIGHT_SALARY=0.15
RANKING_WEIGHT_BEGINNER=0.10
RANKING_WEIGHT_AI_RELATED=0.15
RANKING_WEIGHT_ENGLISH=0.05
RANKING_WEIGHT_SIMPLICITY=0.10
RANKING_WEIGHT_FRESHNESS=0.10

# Notification Threshold
MIN_SCORE_FOR_NOTIFICATION=50

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# ── AE-OS Enterprise Multi-Agent Backbone ────────────────────────────────
# Enable the AE-OS core backbone
AEOS_ENABLED=false

# PostgreSQL (Tier 2 Episodic Memory)
#
# AEOS_POSTGRES_PASSWORD is the SINGLE SOURCE OF TRUTH for the database
# password. docker-compose.yml feeds it to BOTH the postgres service
# (POSTGRES_PASSWORD) and the app container, so the two can never drift.
# Set it once here; never hardcode it in docker-compose.yml.
# Generate a strong value for production, e.g.:
#   openssl rand -base64 24
# NOTE: PostgreSQL only applies this on FIRST init of the data volume. If the
# volume already exists, changing it here has no effect — see DEPLOYMENT.md.
AEOS_POSTGRES_DSN=
AEOS_POSTGRES_HOST=localhost
AEOS_POSTGRES_PORT=5432
AEOS_POSTGRES_USER=aeos
AEOS_POSTGRES_PASSWORD=aeos_password
AEOS_POSTGRES_DATABASE=aeos_episodic

# Redis (Tier 1 Working Memory / Keyspace Events)
AEOS_REDIS_URL=redis://localhost:6379/0

# Neo4j (Tiers 4-7 Epistemic Graph)
AEOS_NEO4J_URI=bolt://localhost:7687
AEOS_NEO4J_USER=neo4j
AEOS_NEO4J_PASSWORD=aeos_neo4j

# Qdrant (Tier 3 Vector Store)
AEOS_QDRANT_HOST=localhost
AEOS_QDRANT_PORT=6333

# Prometheus Metrics
AEOS_METRICS_PORT=9090

# API Sentinel
AEOS_IDEMPOTENCY_SECRET=aeos-idempotency-secret-change-me
AEOS_TREASURY_MAX=1000.0

# ── AI Interview System ─────────────────────────────────────────────────────
# Provider-agnostic: any OpenAI-compatible /chat/completions endpoint works
# (OpenAI, Groq, Together, OpenRouter, Azure, vLLM, llama.cpp, Ollama).
# When LLM_API_KEY + LLM_MODEL are unset the interview model is reported
# unavailable and every interview runs as an unscored transcript rehearsal —
# it never fabricates a score. See docs/INTERVIEW_API.md.
#
# Master kill-switch. false disables AI evaluation (transcript-only mode).
INTERVIEW_ENABLED=true
# Chat-completions base URL. Leave blank to default to https://api.openai.com/v1.
# For a local server (Ollama/llama.cpp) set e.g. http://localhost:11434/v1.
LLM_BASE_URL=
# Secret — keep in .env only, never in frontend code. Omit for local servers.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=30.0
# Retry/backoff budget for one completion call.
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=8.0
LLM_RETRY_DEADLINE_SECONDS=30.0
# Interview sizing / limits.
INTERVIEW_MAX_QUESTIONS=12
INTERVIEW_MIN_QUESTIONS=5
INTERVIEW_MAX_QUESTIONS_SKILLED=20
INTERVIEW_MAX_SESSIONS=50
INTERVIEW_SESSION_TTL_SECONDS=7200
# Retention (days) for completed interview rooms; transcripts/results.
INTERVIEW_ROOM_RETENTION_DAYS=90
# On-disk store for interview sessions/rooms (separate from the job DB).
INTERVIEW_DB_PATH=data/interview.db
# Background evaluation worker. true = in-process asyncio queue (or Redis when
# REDIS_URL is set); false = evaluate inline.
WORKER_ENABLED=true
