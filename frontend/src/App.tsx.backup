import {
  Component,
  Suspense,
  lazy,
  useEffect,
  useState,
  type ReactNode,
} from "react";
import {
  BrowserRouter,
  Link,
  Navigate,
  Route,
  Routes,
  useLocation,
} from "react-router-dom";
import { Navbar } from "./components/navigation/Navbar";
import { CinematicBackground } from "./components/cinematic/CinematicBackground";
import { AuthModal } from "./components/auth/AuthModal";
import { CommandPalette } from "./components/commands/CommandPalette";
import { useAuth } from "./stores/AuthContext";

// Lazy load pages for code splitting
const LandingPage = lazy(() => import("./pages/LandingPage").then(m => ({ default: m.LandingPage })));
const OpportunitiesPage = lazy(() => import("./pages/OpportunitiesPage").then(m => ({ default: m.OpportunitiesPage })));
const JobDetailPage = lazy(() => import("./pages/JobDetailPage").then(m => ({ default: m.JobDetailPage })));
const SavedPage = lazy(() => import("./pages/SavedPage").then(m => ({ default: m.SavedPage })));
const AboutPage = lazy(() => import("./pages/AboutPage").then(m => ({ default: m.AboutPage })));
const SourcesPage = lazy(() => import("./pages/SourcesPage").then(m => ({ default: m.SourcesPage })));
const CategoriesPage = lazy(() => import("./pages/CategoriesPage").then(m => ({ default: m.CategoriesPage })));
const ProfilePage = lazy(() => import("./pages/ProfilePage").then(m => ({ default: m.ProfilePage })));
const ApplicationsPage = lazy(() => import("./pages/ApplicationsPage").then(m => ({ default: m.ApplicationsPage })));
const RecommendationsPage = lazy(() => import("./pages/RecommendationsPage").then(m => ({ default: m.RecommendationsPage })));
const AssistantPage = lazy(() => import("./pages/AssistantPage").then(m => ({ default: m.AssistantPage })));

export default function App() {
  const [authModalOpen, setAuthModalOpen] = useState(false);
  const [paletteOpen, setPaletteOpen] = useState(false);
  const { user } = useAuth();

  const handleAuthClick = () => setAuthModalOpen(true);

  // Global ⌘K / Ctrl+K — toggles the command palette from anywhere.
  useEffect(() => {
    const onKey = (event: KeyboardEvent) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        setPaletteOpen((v) => !v);
      }
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, []);

  return (
    <BrowserRouter>
      <div className="app page-shell">
        {/* Cinematic background - full bleed visual layer */}
        <div className="full-bleed">
          <CinematicBackground />
        </div>
        
        {/* Page content - using distributed layout */}
        <main className="section">
          <Navbar
            onAuthClick={handleAuthClick}
            onOpenPalette={() => setPaletteOpen(true)}
          />
          <CommandPalette
            open={paletteOpen}
            onClose={() => setPaletteOpen(false)}
          />

          <ErrorBoundary>
            <ScrollToTop />
            <Suspense fallback={<PageSkeleton />}>
              <Routes>
                <Route path="/" element={<LandingPage />} />
                <Route path="/opportunities" element={<OpportunitiesPage />} />
                <Route path="/opportunities/:slug" element={<JobDetailPage />} />
                <Route path="/saved" element={user ? <SavedPage /> : <Navigate to="/" replace />} />
                <Route path="/applications" element={user ? <ApplicationsPage /> : <Navigate to="/" replace />} />
                <Route path="/recommendations" element={user ? <RecommendationsPage /> : <Navigate to="/" replace />} />
                <Route path="/assistant" element={user ? <AssistantPage /> : <Navigate to="/" replace />} />
                <Route path="/profile" element={user ? <ProfilePage /> : <Navigate to="/" replace />} />
                <Route path="/about" element={<AboutPage />} />
                <Route path="/sources" element={<SourcesPage />} />
                <Route path="/categories" element={<CategoriesPage />} />
                <Route path="*" element={<NotFoundPage />} />
              </Routes>
            </Suspense>
          </ErrorBoundary>
          
          {/* Footer would go here */}
        </main>
        
        {/* Auth modal - floating panel */}
        <AuthModal open={authModalOpen} onClose={() => setAuthModalOpen(false)} />
      </div>
    </BrowserRouter>
  );
}

/** Reset scroll position on every route change (SPA navigation). */
function ScrollToTop() {
  const { pathname } = useLocation();
  useEffect(() => {
    window.scrollTo({ top: 0, behavior: "auto" });
  }, [pathname]);
  return null;
}

/** Never show a blank screen — surface a recoverable error instead. */
class ErrorBoundary extends Component<
  { children: ReactNode },
  { error: Error | null }
> {
  state = { error: null as Error | null };

  static getDerivedStateFromError(error: Error) {
    return { error };
  }

  componentDidCatch(error: Error) {
    // Client-side only — no stack ever leaves the browser.
    console.error("DEDAN Remote UI error:", error.message);
  }

  render() {
    if (this.state.error) {
      return (
        <main className="container container--standard">
          <h1>Something went wrong</h1>
          <p className="muted">
            The interface hit an unexpected error. Reloading usually fixes it.
          </p>
          <button
            type="button"
            className="btn btn-primary"
            onClick={() => window.location.reload()}
          >
            Reload
          </button>
        </main>
      );
    }
    return this.props.children;
  }
}

function NotFoundPage() {
  return (
    <main className="container container--standard">
      <p className="mono muted">404</p>
      <h1>Page not found</h1>
      <p className="muted">
        That route does not exist. Try the opportunity explorer instead.
      </p>
      <Link to="/opportunities" className="btn btn-primary">
        Explore opportunities
      </Link>
    </main>
  );
}

function PageSkeleton() {
  return (
    <main className="container container--standard">
      <div className="skeleton" style={{ height: 48, width: "60%", marginBottom: "var(--sp-8)" }} />
      <div className="skeleton" style={{ height: 24, width: "40%", marginBottom: "var(--sp-12)" }} />
      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(300px, 1fr))", gap: "var(--sp-6)" }}>
        {Array.from({ length: 6 }).map((_, i) => (
          <div key={i} className="skeleton" style={{ height: 280, borderRadius: "var(--radius-lg)" }} />
        ))}
      </div>
    </main>
  );
}
